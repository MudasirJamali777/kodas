-- core/time.kds - Time and duration

fn seconds(n) => n
fn millis(n) => n / 1000.0
fn minutes(n) => n * 60
fn hours(n) => n * 3600
fn days(n) => n * 86400

fn duration_seconds(ns) => ns / 1000000000.0
fn duration_millis(ns) => ns / 1000000.0

fn unix() => clock()

fn sleep_secs(secs) {
    let start = clock()
    loop while clock() - start < secs {
        skip
    }
}
