-- core/collections.kds - Collection utilities

-- Create a range from start to end (exclusive)
fn range(start, end) => builtin_range(start, end)

-- Sum all numbers in a list
fn sum(list) {
    let mut s = 0
    loop item in list { s = s + item }
    give s
}

-- Product of all numbers in a list
fn product(list) {
    let mut p = 1
    loop item in list { p = p * item }
    give p
}

-- Find maximum value in a list
fn max(list) {
    if list.len == 0 { give err("empty list") }
    let mut best = list[0]
    loop i in 1..list.len {
        if list[i] > best { best = list[i] }
    }
    give ok(best)
}

-- Find minimum value in a list
fn min(list) {
    if list.len == 0 { give err("empty list") }
    let mut best = list[0]
    loop i in 1..list.len {
        if list[i] < best { best = list[i] }
    }
    give ok(best)
}

-- Check if all elements satisfy predicate (named `every` because `any` is a keyword;
-- kept as canonical name; users can alias `all` locally).
fn every(list, pred) {
    loop item in list {
        if !pred(item) { give false }
    }
    give true
}

-- Check if any element satisfies predicate (named `some` to avoid keyword conflict)
fn some(list, pred) {
    loop item in list {
        if pred(item) { give true }
    }
    give false
}

-- Reverse a list
fn reverse(list) {
    let mut result = []
    let mut i = list.len - 1
    loop while i >= 0 {
        result.push(list[i])
        i = i - 1
    }
    give result
}

-- Zip two lists into a list of tuples
fn zip(a, b) {
    let result = []
    let n = if a.len < b.len then a.len else b.len
    loop i in 0..n {
        result.push((a[i], b[i]))
    }
    give result
}

-- Enumerate: returns list of (index, item) tuples
fn enumerate(list) {
    let result = []
    loop i in 0..list.len {
        result.push((i, list[i]))
    }
    give result
}

-- Reduce (foldl): reduce(list, init, fn(acc, item) => ...)
fn reduce(list, init, f) {
    let mut acc = init
    loop item in list { acc = f(acc, item) }
    give acc
}

-- Map: map(list, fn(x) => ...)
fn map(list, f) {
    let result = []
    loop item in list { result.push(f(item)) }
    give result
}

-- Filter: filter(list, fn(x) => bool)
fn filter(list, pred) {
    let result = []
    loop item in list {
        if pred(item) { result.push(item) }
    }
    give result
}

-- Check if list contains value
fn contains(list, val) => some(list, fn(x) => x == val)

-- Index of value in list, or -1
fn index_of(list, val) {
    loop i in 0..list.len {
        if list[i] == val { give i }
    }
    give -1
}
