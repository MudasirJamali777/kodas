-- kitchen_sink.kds - End-to-end feature smoke test exercising most language features

-- Structs + behave + traits
trait Describable {
  fn label(self) -> String { give "thing" }
}

struct Point { x: Float, y: Float }
impl Describable for Point {
  fn label(self) -> String { give "Point" }
}

behave Point {
  fn make(x: Float = 0.0, y: Float = 0.0) -> Point { give Point { x: x, y: y } }
  fn dist(self, other: Point) -> Float {
    let dx = self.x - other.x
    let dy = self.y - other.y
    give (dx * dx + dy * dy)
  }
}

-- Enums with payload, maybe, Result, error pipe, otherwise, demand
enum Shape { Circle(Float), Rect(Float, Float) }

fn safe_sqrt(x: Float) -> Result {
  if x < 0.0 { give err("negative") }
  give ok(x)
}

-- Compound ops, loops, tuples, destructuring
let mut sum = 0
let mut i = 0
loop while i <= 10 {
  sum += i
  i += 1
}
assert(sum == 55)

let (a, b) = (10, "hello")
assert(a == 10)
assert(b == "hello")

-- Default params, generics via duck typing, list HOFs
fn greet(name: String = "World") -> String { give "Hi, " + name }
assert(greet() == "Hi, World")
assert(greet("Alice") == "Hi, Alice")

let xs = [1, 2, 3, 4]
let doubled = xs.map(fn(x) { give x * 2 })
assert(doubled.len() == 4)
assert(doubled[0] == 2)

-- C backend targets this kind of code natively
fn fib(n: Int) -> Int {
  if n <= 1 { give n }
  give fib(n-1) + fib(n-2)
}
assert(fib(15) == 610)

-- Bench (measures runtime)
bench "fib(20)" {
  let f20 = fib(20)
}

-- Show something
let p = Point.make(3.0, 4.0)
show p.label()

show "  [ok] structs + behave + traits"
show "  [ok] enums/Result/maybe/error pipe/otherwise/demand"
show "  [ok] compound assignments, loops, destructuring"
show "  [ok] defaults, generics (duck-typed), higher-order fns"
show "  [ok] recursion, bench blocks, C-backend-eligible code"
show "=== kitchen-sink feature test passed ==="
