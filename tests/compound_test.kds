-- compound_test.kds - Compound assignment operators (+=, -=, *=, /=, %=)

let mut x = 10
x += 5
assert(x == 15, "+= works")

x -= 3
assert(x == 12, "-= works")

x *= 2
assert(x == 24, "*= works")

x /= 4
assert(x == 6, "/= works")

x %= 4
assert(x == 2, "%= works")

-- Chained compound ops
let mut sum = 0
let mut i = 1
loop while i <= 100 {
  sum += i
  i += 1
}
assert(sum == 5050, "sum 1..100 via +=")

-- Float compound ops
let mut f = 1.0
f += 0.5
f *= 4.0
assert(f == 6.0, "float += and *=")

-- String concatenation with +=
let mut s = "Hello"
s += ", World"
assert(s == "Hello, World", "string +=")

show "  [ok] += -= *= /= %= on ints"
show "  [ok] float compound ops"
show "  [ok] string += concatenation"
show "  [ok] compound ops in loops"
show "=== compound assignment tests passed ==="
